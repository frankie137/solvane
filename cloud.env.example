# Template for cloud function secrets and settings. The real file is .keys/cloud.env (never committed to git; readable and writable by you only).
# After filling it in, run pnpm cloud:config: the script sets each cloud function's timeout and sends it only the variables it needs; it never prints any value.

# compose, assess: a random string used to encrypt the LLM API key.
# Leave empty and the script generates one and writes it back. Once generated, don't change or delete it, or the saved API key can no longer be decrypted and must be entered again.
KEY_ENCRYPTION_SECRET=

# compose, data, assess: admin user IDs (OpenID), separated by ASCII commas. In the mini program, tap Me → User ID (「我的 → 用户 ID」) to copy it.
# Admins can configure the LLM and manage memberships, and always count as Pro themselves.
ADMIN_OPENIDS=

# speech, assess: Tencent Cloud sub-account keys authorized for speech recognition (ASR), TTS and the new pronunciation assessment (SOE, 「口语评测（新版）」).
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# assess: the AppID of your Tencent Cloud account (a number, under Account Info (「账号信息」) in Tencent Cloud), not the WeChat AppID. Required by the new pronunciation assessment (SOE, 「口语评测（新版）」).
SOE_APP_ID=
