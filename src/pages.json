{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {}
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundColorTop": "@bgColor",
    "backgroundColorBottom": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^sv-(.*)": "@/components/sv-$1/sv-$1.vue"
    }
  },
  "subPackages": [
    {
      "root": "pkg-session",
      "pages": [
        {
          "path": "session/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-settings",
      "pages": [
        {
          "path": "llm/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-dev",
      "pages": [
        {
          "path": "gallery/index",
          "style": {}
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pkg-session"]
    }
  }
}
