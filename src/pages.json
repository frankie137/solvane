{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {}
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "backgroundColor": "@bgColor",
    "backgroundColorTop": "@bgColor",
    "backgroundColorBottom": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^sv-(.*)": "@/components/sv-$1/sv-$1.vue"
    }
  },
  "subPackages": [
    {
      "root": "pkg-session",
      "pages": [
        {
          "path": "session/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-recite",
      "pages": [
        {
          "path": "recite/index",
          "style": {}
        },
        {
          "path": "report/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-library",
      "pages": [
        {
          "path": "folder/index",
          "style": {}
        },
        {
          "path": "expression/index",
          "style": {}
        },
        {
          "path": "history/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-share",
      "pages": [
        {
          "path": "play/index",
          "style": {
            "navigationBarTextStyle": "white",
            "backgroundColor": "#0b0b14",
            "backgroundColorTop": "#0b0b14",
            "backgroundColorBottom": "#0b0b14"
          }
        },
        {
          "path": "mine/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-settings",
      "pages": [
        {
          "path": "llm/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-admin",
      "pages": [
        {
          "path": "members/index",
          "style": {}
        }
      ]
    },
    {
      "root": "pkg-dev",
      "pages": [
        {
          "path": "gallery/index",
          "style": {}
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pkg-session", "pkg-library"]
    },
    "pkg-session/session/index": {
      "network": "all",
      "packages": ["pkg-recite"]
    }
  }
}
