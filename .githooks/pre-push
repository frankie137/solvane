#!/bin/sh
# Pre-push check: secret files must never enter version control; then run the full check, same as CI.
# In an emergency, skip with git push --no-verify (not recommended).

tracked_secrets=$(git ls-files -- '.keys' '*.key' 'cloud.env' '.env.local')
if [ -n "$tracked_secrets" ]; then
  echo "pre-push: the following secret files are tracked by git; push blocked:"
  echo "$tracked_secrets"
  echo "Remove them from version control with git rm --cached <file>, and make sure .gitignore covers them."
  exit 1
fi

echo "pre-push: running pnpm check..."
pnpm check
